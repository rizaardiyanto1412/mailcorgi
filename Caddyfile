{
	# Custom website hosts get a certificate on first visit, once MailCorgi says the host is known.
	on_demand_tls {
		ask http://mailcorgi:3000/api/public/tls-check
	}
}

# The app host, from DOMAIN in .env.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy mailcorgi:3000
}

# Any other host: a newsletter website on a custom domain.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy mailcorgi:3000
}

http:// {
	redir https://{host}{uri} permanent
}
