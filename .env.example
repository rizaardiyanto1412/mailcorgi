# Settings for `docker compose`. Copy to .env and uncomment what you need, or run scripts/install.sh.
# Every line is optional. The full list is in docs/self-hosting.md under "Environment variables".
#
# The public address. With the https profile, use https://DOMAIN.
# APP_URL=https://news.example.com
# DOMAIN=news.example.com
#
# Who runs this install, and who else may sign up.
# ADMIN_EMAILS=you@example.com
# ALLOWED_EMAILS=friend@example.com
#
# Host ports. MAILCORGI_PORT is the plain HTTP port on this machine; BIND=0.0.0.0 opens it to the network.
# MAILCORGI_PORT=3000
# BIND=127.0.0.1
# Reverse proxies whose X-Forwarded-For counts. Compose already trusts its own Caddy and nothing else.
# TRUST_PROXY=172.31.250.10
# HTTP_PORT=80
# HTTPS_PORT=443
#
# Email provider keys can live here instead of in Admin -> Email. Env values win over saved settings.
# EMAIL_PROVIDER=ses
# SES_REGION=eu-west-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
