{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailcorgi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built web app. The Worker runs first for everything except hashed build assets, and serves
  // the SPA shell for client routes itself, so a missing /assets/ file is a 404, not index.html.
  // web/public/_headers makes /assets/* immutable.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlStore" },
      { "name": "ACCOUNT", "class_name": "AccountStore" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlStore", "AccountStore"] }],
  // Images. R2 must be enabled on the account once. Without R2, delete this block: images then
  // live in chunks inside each account's Durable Object.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "mailcorgi-images" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  // Variables set in the dashboard survive later deploys from Git.
  "keep_vars": true,
  "vars": {
    // Workers Free allows 50 outbound requests per run. Remove this line on Workers Paid.
    "WORKERS_PLAN": "free"
    // Optional, here or in the dashboard: "APP_URL": "https://news.example.com", "ADMIN_EMAILS": "you@example.com", "CLOUD": "true"
  }
}
