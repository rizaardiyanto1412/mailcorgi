{
  "name": "mailcorgi",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "MailCorgi: a newsletter app that runs on Cloudflare Workers or any Node.js server",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "dev:cf": "npm run build:web && wrangler dev",
    "build": "npm run build:web && npm run build:server && wrangler deploy --dry-run --outdir dist/worker",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --sourcemap",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint server worker web/src scripts",
    "test": "tsx --test server/test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "live:check": "tsx scripts/live-check.ts",
    "ci": "sh scripts/ci.sh",
    "deploy": "npm run build:web && wrangler deploy",
    "docs:api": "tsx scripts/docs-api.ts",
    "test:slow": "tsx --test server/test/*.slow.ts",
    "ui:pass": "tsx scripts/ui-pass.ts",
    "budget": "tsx scripts/write-budget.ts",
    "oauth:e2e": "tsx scripts/oauth-e2e.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bubble-menu": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.18",
    "marked": "^18.2.0",
    "nodemailer": "^10.5.0",
    "papaparse": "^5.7.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.71.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  },
  "cloudflare": {
    "bindings": {
      "CONTROL": {
        "description": "Durable Object for users, sessions, accounts and install settings. Created for you."
      },
      "ACCOUNT": {
        "description": "One Durable Object per account: newsletters, contacts, campaigns and stats. Created for you."
      },
      "IMAGES": {
        "description": "R2 bucket for uploaded images. R2 must be enabled on your account once (**R2 \u2192 Overview** in the dashboard). Without R2, delete the `r2_buckets` block in `wrangler.jsonc`."
      },
      "WORKERS_PLAN": {
        "description": "Keep `free` on Workers Free. On Workers Paid, delete the `WORKERS_PLAN` line from `wrangler.jsonc` in your repository so each send run can make up to 900 requests."
      }
    }
  }
}
